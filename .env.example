# Copy this file to .env and fill in the values before running docker compose up.
# Never commit the .env file to version control.

# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_DATABASE=repaircafepage
MYSQL_USER=repaircafe
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# ── Flask ─────────────────────────────────────────────────────────────────────
# Secret key for session signing – use a long random string in production.
FLASK_SECRET_KEY=change_me_secret

# ── Email export (optional) ───────────────────────────────────────────────────
EMAIL_ENABLED=false
MAIL_TOKEN=
MAIL_SENDER=
MAIL_SENDER_NAME=RepairCafe
EXPORT_MAIL_RECEIVER=
ZIP_PASSWORD=

# ── Label printer (optional) ──────────────────────────────────────────────────
# Set LABEL_PRINTER_ENABLED=true to show the print button and enable the endpoint.
# Printing is done via CUPS on the Docker host (see docs/CUPS_NETWORK_SETUP.md).
# LABEL_PRINTER_ENABLED=false
# LABEL_PRINTER_NAME=SLP650

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Not needed when the frontend is served through nginx or the Vite dev proxy
# (same origin). Only set this if another origin must call the API with cookies.
# CORS_ORIGINS=https://example.org

# OIDC is optional; all four values are required to enable SSO.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PUBLIC_URL=http://localhost:5173
OIDC_SCOPES=openid email profile
OIDC_PIN_CLAIM=pin_code
OIDC_ADMIN_CLAIM=repaircafe_admin
OIDC_GROUPS_CLAIM=groups
OIDC_DENIED_GROUPS=

# local: users explicitly generate a PIN in their profile (displayed once).
# oidc: PINs come only from OIDC_PIN_CLAIM; profile generation is disabled.
# The application default is oidc to preserve legacy provider PIN ownership.
PIN_MODE=local
# Changing an existing mode deletes ALL PINs and requires acknowledgement:
# PIN_MODE_RESET_ACK=oidc-to-local   (or local-to-oidc)
PIN_MODE_RESET_ACK=

# Existing easyVerein/Authentik integration:
# PIN_MODE=oidc
# OIDC_ISSUER=https://auth.example/application/o/repaircafe-page/
# OIDC_SCOPES=openid email profile repaircafe
# OIDC_PIN_CLAIM=door_code
# OIDC_ADMIN_CLAIM=repaircafe_admin
# OIDC_GROUPS_CLAIM=groups
# OIDC_DENIED_GROUPS=Kind
SESSION_COOKIE_SECURE=false