# Docker Compose configuration: copy to .env and replace every change_me value.
# Never commit .env or share its secrets. See README.md for deployment details.
# Changes require recreating the backend container, not just restarting it:
# docker compose up -d --force-recreate backend

# -- Database ----------------------------------------------------------------
# Application database and non-root database account, created on first startup.
# Changing these values does not update accounts in an existing database volume.
MYSQL_DATABASE=repaircafepage
MYSQL_USER=repaircafe
MYSQL_PASSWORD=change_me

# Separate MariaDB root password; do not reuse the application user's password.
MYSQL_ROOT_PASSWORD=change_me_root

# -- Application and Cookies -------------------------------------------------
# Stable random secret for session signing and keyed PIN hashes.
# Generate with: openssl rand -hex 32
# Changing this secret invalidates sessions and existing PIN hashes.
FLASK_SECRET_KEY=change_me_secret

# Browser-facing application URL, without a trailing slash or /api suffix.
# Development: http://localhost:5173; production: https://repairs.example.org
# Required for SSO, including when HTTPS terminates at a reverse proxy.
PUBLIC_URL=http://localhost:5173

# true for HTTPS deployments; false only for local/plain-HTTP deployments.
# Secure cookies are not sent over ordinary HTTP connections.
SESSION_COOKIE_SECURE=false

# Optional directory overrides for persistent data and bundled config templates.
# Defaults to <project_root>/data and <project_root>/config in local dev,
# and /data and /config inside the Docker container.
# DATA_DIR=/data
# CONFIG_DIR=/config

# -- OIDC Login (Optional) ---------------------------------------------------
# SSO requires OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET and PUBLIC_URL.
# Leave issuer/client credentials empty to use local username/password login.
# With SSO enabled, password login is restricted to local admin accounts.

# Issuer URL from the provider, NOT its login or authorization endpoint.
# Discovery is loaded from <issuer>/.well-known/openid-configuration.
OIDC_ISSUER=

# Credentials from the provider's registered OIDC application.
# Register <PUBLIC_URL>/api/auth/oidc/callback as its exact redirect URI.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Space-separated scopes. Add provider-specific scopes only when configured
# by that provider; standard providers do not need the repaircafe scope.
OIDC_SCOPES=openid email profile

# Top-level claim containing a six-digit PIN, including possible leading zeroes.
# Used only with PIN_MODE=oidc. Missing/invalid values remove the stored PIN
# at the next SSO login but do not prevent login. No local fallback is created.
OIDC_PIN_CLAIM=pin_code

# Top-level admin claim. Only boolean true or the string "true" grants admin.
# Missing/false values mean non-admin; set empty to disable this mapping.
# This role is synchronized on each SSO login; local admins are not adopted.
OIDC_ADMIN_CLAIM=repaircafe_admin

# Top-level group claim: a list of group names, or one group name as a string.
# Set empty if your provider does not supply groups or no mapping is needed.
OIDC_GROUPS_CLAIM=groups

# Comma-separated, case-sensitive group names whose SSO login is refused.
# Example: Kind,Guests. Empty means no group restrictions, NOT no access.
# This is a deny-list: users in other groups are allowed to sign in.
OIDC_DENIED_GROUPS=

# -- PIN Ownership ----------------------------------------------------------
# Choose exactly one deployment-wide mode:
# local: users explicitly generate/replace a PIN in their profile after login.
#        Each generated PIN is displayed once and stored only as a unique hash.
#        Provider PIN claims are ignored; no PIN is created automatically.
# oidc:  the provider supplies the PIN; generation/replacement here is disabled.
#        Users retrieve/change their PIN through the provider, not this app.
# This example selects local; the application's unset-variable default is oidc
# to preserve existing provider-owned PINs. PIN unlocking itself is not yet built.
PIN_MODE=local

# Leave empty during normal operation. Changing an existing mode deletes ALL
# stored PINs and refuses startup unless the exact transition is acknowledged:
#   oidc -> local: PIN_MODE_RESET_ACK=oidc-to-local
#   local -> oidc: PIN_MODE_RESET_ACK=local-to-oidc
# Back up the database and stop all old backend instances before changing modes.
# After a successful switch, remove the acknowledgement and recreate the backend.
# The reset happens once; accounts/sessions remain, but PINs must be generated
# again (local) or synchronized at the next SSO login (oidc).
PIN_MODE_RESET_ACK=

# -- easyVerein via Authentik (Override Example) ------------------------------
# Replace the matching values above; do not add duplicate active assignments.
# Also fill in the client credentials and your real PUBLIC_URL.
# OIDC_ISSUER=https://auth.example/application/o/repaircafe-page/
# OIDC_SCOPES=openid email profile repaircafe
# OIDC_PIN_CLAIM=door_code
# OIDC_ADMIN_CLAIM=repaircafe_admin
# OIDC_GROUPS_CLAIM=groups
# OIDC_DENIED_GROUPS=Kind
# PIN_MODE=oidc

# -- Email Export (Optional, Mailtrap) ---------------------------------------
# Set to true and supply credentials below when using email exports.
EMAIL_ENABLED=false

# Mailtrap API token, verified sender email address and displayed sender name.
MAIL_TOKEN=
MAIL_SENDER=
MAIL_SENDER_NAME=RepairCafe

# Destination email address and password for the encrypted export ZIP archive.
# Choose a strong ZIP password before enabling exports.
EXPORT_MAIL_RECEIVER=
ZIP_PASSWORD=

# -- Label Printer (Optional, CUPS) ------------------------------------------
# Set to true to expose the "Print Label" button in the UI and enable the
# POST /api/print-label/<id> endpoint.
# Requires:
#   1. CUPS running on the Docker host (/run/cups/cups.sock).
#   2. Mounting /run/cups/cups.sock:/run/cups/cups.sock into the backend container
#      in compose.yaml.
# See docs/CUPS_NETWORK_SETUP.md for local USB and remote print server setup.
LABEL_PRINTER_ENABLED=false

# Exact CUPS queue name configured on the Docker host (verify with `lpstat -p`).
# - Local USB printer on Docker host: name of the local USB queue (e.g. SLP650).
# - Remote print server (e.g. Raspberry Pi): name of the local IPP Everywhere
#   relay queue on the Docker host (e.g. SLP650 -> ipp://<printserver>:631/printers/SII_SLP650).
LABEL_PRINTER_NAME=SLP650

# -- Cross-Origin Requests (Optional, Advanced) ------------------------------
# Unnecessary with the normal nginx/Vite same-origin proxy setup.
# For a separately hosted frontend, use comma-separated exact origins
# (scheme + hostname + optional port), without paths or a wildcard.
# Set this in the backend environment directly; the supplied compose.yaml does
# not forward CORS_ORIGINS from .env unless you add it to backend.environment.
# CORS_ORIGINS=https://frontend.example.org