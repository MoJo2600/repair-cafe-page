{
  "name": "repaircafe-frontend",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src --fix",
    "format": "prettier --write src",
    "generate-api": "swagger-typescript-api generate -p ./openapi.json -o ./src/api/generated --modular --extract-request-params --extract-request-body --unwrap-response-data"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.6.1",
    "jsqr": "^1.4.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "swagger-typescript-api": "^13.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.14"
  }
}
