{
  "name": "repaircafe-frontend",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src --fix",
    "format": "prettier --write src",
    "generate-api": "swagger-typescript-api generate -p ./openapi.json -o ./src/api/generated --modular --extract-request-params --extract-request-body --unwrap-response-data"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/vue-3": "^3.35.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.6.2",
    "dompurify": "^3.5.0",
    "jsqr": "^1.4.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-chartjs": "^5.3.7",
    "vue-router": "^5.5.1",
    "vuetify": "^4.3.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "swagger-typescript-api": "^13.15.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.14"
  }
}
