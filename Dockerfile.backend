# ── Backend: Python + Gunicorn ────────────────────────────────────────────────
FROM python:3.15-slim

# /srv mirrors the repo root: wsgi.py here, app/ is the Flask package.
WORKDIR /srv

# System packages required by Python deps (PyMuPDF, Pillow), PDF fonts, and CUPS label printing
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-dejavu-core libglib2.0-0 libgl1 cups-client \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /etc/cups && echo "ServerName /run/cups/cups.sock" > /etc/cups/client.conf

# Python dependencies (separate layer for caching)
COPY app/requirements.txt app/requirements.txt
RUN pip install --no-cache-dir -r app/requirements.txt

# Application code — app/ becomes /srv/app/ (importable as the 'app' package)
COPY app/ /srv/app/
COPY wsgi.py /srv/wsgi.py
COPY VERSION /srv/VERSION
COPY config/ /config/

COPY entrypoint.backend.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Break-glass admin password reset, callable from a container shell (e.g. Dockge)
RUN chmod +x /srv/app/reset_admin_password.py \
  && ln -s /srv/app/reset_admin_password.py /usr/local/bin/reset-admin-password

# Persistent data & config directory defaults for container runtime
ENV DATA_DIR=/data \
    CONFIG_DIR=/config

# Run without root. uid 1000 matches the host owner of the bind-mounted data
# directory; an existing directory with root-owned files needs a one-time
# `chown -R 1000:1000` on the host.
RUN useradd --uid 1000 --user-group --create-home --shell /usr/sbin/nologin app \
  && mkdir -p /data && chown app:app /data
USER app

# Gunicorn listens on 5000; only exposed to the internal Docker network.
EXPOSE 5000

# Runs migrations then starts Gunicorn
ENTRYPOINT ["/entrypoint.sh"]
